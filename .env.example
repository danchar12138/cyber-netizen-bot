# Bootstrap settings only. Runtime behavior belongs in the configuration registry.
CNB_ENVIRONMENT=development
CNB_LOG_LEVEL=INFO
CNB_DATABASE_URL=postgresql+psycopg://cyber_netizen:cyber_netizen@localhost:5432/cyber_netizen
CNB_REDIS_URL=redis://localhost:6379/0
CNB_S3_ENDPOINT_URL=http://localhost:9000
CNB_S3_ACCESS_KEY=cyber-netizen
CNB_S3_SECRET_KEY=change-this-development-secret
CNB_S3_BUCKET=cyber-netizen
CNB_CONFIG_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
CNB_CORS_ORIGINS=["http://localhost:5173"]
CNB_READINESS_DEEP_CHECKS=false

# Compose-only bootstrap credentials
POSTGRES_PASSWORD=cyber_netizen
MINIO_ROOT_USER=cyber-netizen
MINIO_ROOT_PASSWORD=change-this-development-secret

