# 仅包含启动配置；运行行为配置属于配置注册表。
CNB_ENVIRONMENT=development
CNB_LOG_LEVEL=INFO
CNB_DATABASE_URL=postgresql+psycopg://cyber_netizen:cyber_netizen@localhost:5432/cyber_netizen
CNB_REDIS_URL=redis://localhost:6379/0
CNB_MINIO_ENDPOINT_URL=http://localhost:9000
CNB_MINIO_ACCESS_KEY=cyber-netizen
CNB_MINIO_SECRET_KEY=change-this-development-secret
CNB_MINIO_BUCKET=cyber-netizen
# 仅供本地开发；预发布与生产必须替换为随机生成的 Base64 32 字节主密钥。
CNB_CONFIG_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CNB_CORS_ORIGINS=["http://localhost:5173"]
CNB_READINESS_DEEP_CHECKS=false

# OpenTelemetry 是数据库可用前的启动链路；SLO、告警和成本阈值在管理后台配置中心管理。
CNB_OTEL_ENABLED=false
CNB_OTEL_SERVICE_NAME=cyber-netizen-api
# CNB_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
# CNB_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-me
CNB_OTEL_TRACE_SAMPLE_RATIO=0.1

# 正式环境身份引导。development/test 默认保留开发身份；staging/production 必须改为 oidc。
CNB_AUTHENTICATION_MODE=development
# CNB_OIDC_ISSUER_URL=https://identity.example.com/realms/cyber-netizen
# CNB_OIDC_CLIENT_ID=cyber-netizen-web
# CNB_OIDC_AUDIENCE=cyber-netizen-api
# CNB_OIDC_SCOPES=["openid","profile","email"]
# CNB_OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
# CNB_OIDC_TENANT_NAME=Cyber Netizen
# CNB_OIDC_AGENT_ID=00000000-0000-0000-0000-000000000000
# CNB_OIDC_AGENT_NAME=赛博网友
# CNB_OIDC_ROLE_CLAIM=cnb_role
# CNB_OIDC_DISPLAY_NAME_CLAIM=name
# CNB_OIDC_ALLOWED_ALGORITHMS=["RS256"]
# CNB_OIDC_JWKS_CACHE_SECONDS=300

# 仅供 Compose 使用的启动凭证
POSTGRES_PASSWORD=cyber_netizen
MINIO_ROOT_USER=cyber-netizen
MINIO_ROOT_PASSWORD=change-this-development-secret
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173
